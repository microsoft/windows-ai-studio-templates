[
    {
        "groupId": "data",
        "fields": [
            {
                "type": "String",
                "label": "Training Dataset name:",
                "info": "Dataset to train the model from a local file.",
                "defaultValue": "",
                "fileName": "train.json",
                "required": true,
                "savePath": "dataset",
                "sample": "{\"messages\":[{\"content\":\"Hello, bot.\",\"role\":\"user\"},{\"content\":\"Hi! How can I assist?\",\"role\":\"assistant\"}]}\n{\"messages\":[{\"content\":\"Who are you?\",\"role\":\"user\"},{\"content\":\"I am your assistant.\",\"role\":\"assistant\"}]}"
            },
            {
                "type": "String",
                "label": "Test Dataset name:",
                "info": "Dataset to evaluate the model from a local file.",
                "defaultValue": "",
                "fileName": "test.json",
                "required": true,
                "savePath": "dataset",
                "sample": "{\"messages\":[{\"content\":\"Hello, bot.\",\"role\":\"user\"},{\"content\":\"Hi! How can I assist?\",\"role\":\"assistant\"}]}\n{\"messages\":[{\"content\":\"Who are you?\",\"role\":\"user\"},{\"content\":\"I am your assistant.\",\"role\":\"assistant\"}]}"
            },
            {
                "type": "String",
                "defaultValue": null,
                "info": "Optional system prompt. If specified, the system prompt given here will be prepended to each example in the dataset as the system prompt when training the LoRA adapter. When running inference the same (or a very similar) system prompt should be used. Note: if a system prompt is specified in the training data, giving a system prompt here will overwrite the system prompt in the dataset.",
                "label": "System prompt:",
                "required": false,
                "id": "system_prompt"
            },
            {
                "type": "Boolean",
                "defaultValue": false,
                "info": "Varied sequence lengths in the calibration data. If False (default), training examples will be concatenated together until they are finetune_[train/test]_seqlen tokens long. This makes memory usage more consistent and predictable. If True, each individual example will be truncated to finetune_[train/test]_seqlen tokens. This can sometimes give better training performance, but also gives unpredictable memory usage. It can cause `out of memory` errors mid training, if there are long training examples in your dataset.",
                "label": "Allow varied sequence length in data:",
                "required": false,
                "id": "varied_seqlen"
            },
            {
                "type": "Integer",
                "defaultValue": 4096,
                "info": "Number of samples to load from the train set for finetuning. For quick experiments, at least 1024 samples are suggested. Choose no more samples than the number of rows in the training dataset.",
                "hintMessage": "Suggested: 1024+ samples, up to training dataset rows.",
                "label": "Number of finetuning samples:",
                "required": true,
                "id": "finetune_train_nsamples"
            },
            {
                "type": "Integer",
                "defaultValue": 128,
                "info": "Number of samples to load from the test set for finetuning. For quick experiments, at least 32 samples are suggested. Choose no more samples than the number of rows in the test dataset. More samples reduce noise in evaluation loss, but increase training time because evaluation takes longer.",
                "hintMessage": "Suggested: 32+ samples, up to test dataset rows.",
                "label": "Number of test samples:",
                "required": true,
                "id": "finetune_test_nsamples"
            },
            {
                "type": "Integer",
                "defaultValue": 2,
                "info": "Batch size for finetuning training. Use the largest batch size that fits in GPU memory. This is coupled with the max training sequence length: increasing one requires reducing the other.",
                "hintMessage": "Use the largest batch that fits GPU memory.",
                "label": "Training batch size:",
                "required": true,
                "id": "finetune_train_batch_size"
            },
            {
                "type": "Integer",
                "defaultValue": 8,
                "info": "Batch size for finetuning testing. Use the largest batch size that fits in GPU memory. This is coupled with the max test sequence length: increasing one requires reducing the other.",
                "hintMessage": "Use the largest batch that fits GPU memory.",
                "label": "Test batch size:",
                "required": true,
                "id": "finetune_test_batch_size"
            },
            {
                "type": "Integer",
                "defaultValue": 1024,
                "info": "Maximum sequence length for finetuning training. Longer sequences will be truncated. Longer sequences require more GPU memory, so reduce the training batch size when increasing this value.",
                "hintMessage": "Longer sequences need smaller batches.",
                "label": "Max training sequence length:",
                "required": true,
                "id": "finetune_train_seqlen"
            },
            {
                "type": "Integer",
                "defaultValue": 2048,
                "info": "Maximum sequence length for finetuning testing. Longer sequences will be truncated. Longer sequences require more GPU memory, so reduce the test batch size when increasing this value.",
                "hintMessage": "Longer sequences need smaller batches.",
                "label": "Max test sequence length:",
                "required": true,
                "id": "finetune_test_seqlen"
            }
        ],
        "title": "Data"
    },
    {
        "groupId": "finetuning",
        "fields": [
            {
                "type": "Integer",
                "defaultValue": 5,
                "info": "Number of evaluations with no improvement after which training will be stopped.",
                "label": "Early stopping patience:",
                "required": true,
                "id": "early_stopping_patience",
                "min": 1,
                "max": 100
            },
            {
                "type": "Number",
                "defaultValue": 1,
                "info": "Number of total epochs to run.",
                "label": "Epochs:",
                "required": true,
                "id": "epochs",
                "min": 1,
                "max": 100
            },
            {
                "type": "Integer",
                "defaultValue": 64,
                "info": "Number of training steps to perform before each evaluation.",
                "label": "Steps between evaluations:",
                "required": true,
                "id": "eval_steps"
            },
            {
                "type": "Integer",
                "defaultValue": 64,
                "info": "Number of steps after which to save model checkpoint. This _must_ be a multiple of the number of steps between evaluations.",
                "label": "Steps between checkpoints:",
                "required": true,
                "id": "save_steps"
            },
            {
                "type": "Number",
                "defaultValue": 0.0002,
                "info": "Learning rate for training.",
                "label": "Learning rate:",
                "required": true,
                "id": "learning_rate",
                "min": 1e-4,
                "max": 1e-2
            },
            {
                "type": "String",
                "defaultValue": "linear",
                "info": "Type of learning rate scheduler.",
                "label": "Learning rate scheduler:",
                "required": true,
                "id": "lr_scheduler_type",
                "optionValues": [
                    "linear",
                    "linear_with_warmup",
                    "cosine",
                    "cosine_with_warmup"
                ]
            },
            {
                "type": "Integer",
                "defaultValue": 400,
                "info": "Number of warmup steps for learning rate scheduler. Only relevant for a _with_warmup scheduler.",
                "label": "Scheduler warmup steps (if supported):",
                "required": true,
                "id": "num_warmup_steps",
                "min": 0,
                "max": 10000
            }
        ],
        "title": "Finetuning"
    },
    {
        "groupId": "advanced",
        "fields": [
            {
                "type": "Integer",
                "defaultValue": 42,
                "info": "Seed for sampling the data.",
                "label": "Random seed:",
                "required": true,
                "id": "seed"
            },
            {
                "type": "String",
                "defaultValue": "steps",
                "info": "Evaluation strategy to use.",
                "label": "Evaluation strategy:",
                "required": true,
                "id": "evaluation_strategy",
                "optionValues": [
                    "steps",
                    "epoch",
                    "no"
                ]
            },
            {
                "type": "Number",
                "defaultValue": 0.9,
                "info": "Beta1 hyperparameter for Adam optimizer.",
                "label": "Adam beta 1:",
                "required": true,
                "id": "adam_beta1",
                "min": 0.9,
                "max": 0.99
            },
            {
                "type": "Number",
                "defaultValue": 0.95,
                "info": "Beta2 hyperparameter for Adam optimizer.",
                "label": "Adam beta 2:",
                "required": true,
                "id": "adam_beta2",
                "min": 0.9,
                "max": 0.999
            },
            {
                "type": "Number",
                "defaultValue": 1e-08,
                "info": "Epsilon hyperparameter for Adam optimizer.",
                "label": "Adam epsilon:",
                "required": true,
                "id": "adam_epsilon",
                "min": 1e-9,
                "max": 1e-6
            },
            {
                "type": "Number",
                "defaultValue": 0.0,
                "info": "Weight decay coefficient applied by the optimizer. Automatically excluded from bias and LayerNorm parameters.",
                "label": "Weight decay:",
                "required": true,
                "id": "weight_decay",
                "min": 0,
                "max": 1
            },
            {
                "type": "Integer",
                "defaultValue": 1,
                "info": "Number of update steps to accumulate gradients before performing a backward/update pass. Effective batch size = per_device_train_batch_size * num_devices * gradient_accumulation_steps.",
                "label": "Gradient accumulation steps:",
                "required": true,
                "id": "gradient_accumulation_steps",
                "min": 1,
                "max": 128
            },
            {
                "type": "Number",
                "defaultValue": 1.0,
                "info": "Maximum gradient norm for gradient clipping. Must be greater than 0; setting it to 0 prevents training.",
                "label": "Max grad norm:",
                "required": true,
                "id": "max_grad_norm",
                "min": 1e-8
            },
            {
                "type": "Boolean",
                "defaultValue": false,
                "info": "Enable gradient checkpointing to trade compute for memory. Reduces memory at the cost of ~20%% slower training.",
                "label": "Gradient checkpointing:",
                "required": false,
                "id": "gradient_checkpointing"
            },
            {
                "type": "Number",
                "defaultValue": 0,
                "info": "Number of epochs or steps to wait for before the first evaluation can be performed, depending on the eval_strategy.",
                "label": "Eval delay:",
                "required": true,
                "id": "eval_delay"
            },
            {
                "type": "Integer",
                "defaultValue": null,
                "info": "Number of predictions steps to accumulate the output tensors for, before moving the results to the CPU. If unset, predictions are accumulated on the accelerator before being moved to the CPU.",
                "label": "Eval accumulation steps:",
                "required": false,
                "id": "eval_accumulation_steps"
            }
        ],
        "title": "Advanced"
    },
    {
        "groupId": "comparison",
        "collapsible": true,
        "collapsed": true,
        "togglePath": "compare_enabled",
        "fields": [
            {
                "id": "compare_file",
                "type": "String",
                "label": "Dataset name:",
                "info": "Dataset to compare the model from a local file.",
                "defaultValue": "",
                "fileName": "",
                "required": false,
                "savePath": "",
                "sample": "{\"query\": \"Hello, bot.\", \"response\": \"Hi! How can I assist?\"}\n{\"query\": \"Who are you?\", \"response\": \"I am your assistant.\"}"
            },
            {
                "type": "Number",
                "defaultValue": 0.9,
                "info": "Temperature for comparison inference. Higher values produce more diverse outputs.",
                "label": "Temperature:",
                "id": "compare_temperature",
                "required": false,
                "min": 0,
                "max": 2
            }
        ],
        "title": "Comparison"
    }
]
